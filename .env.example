# tools/blogger.mjs 용 자격증명. 이 파일을 .env 로 복사해 값을 채운다.
# 블로그가 여러 개면 .env.blog2 처럼 만들고 --env .env.blog2 로 지정한다.

# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트(데스크톱 앱)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# tools/blogger-auth.mjs 를 1회 실행해 발급받은 값
GOOGLE_REFRESH_TOKEN=

# 둘 중 하나만 있으면 된다. ID 를 넣으면 API 호출이 한 번 줄어든다.
BLOGGER_BLOG_ID=
BLOGGER_BLOG_URL=https://your-blog.blogspot.com
